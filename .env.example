# Server Configuration
PORT=3000
NODE_ENV=development

# API Keys (Add when connecting to real APIs)
# DISCOVERY_API_KEY=your_key_here
# OUTSURANCE_API_KEY=your_key_here

# Database (Optional - for storing callback requests)
# DATABASE_URL=mongodb://localhost:27017/insurecompare
# or
# DATABASE_URL=postgresql://user:password@localhost:5432/insurecompare

# Email Service (Optional - for notifications)
# SENDGRID_API_KEY=your_key_here
# ADMIN_EMAIL=admin@insurecompare.co.za

# Security
# SESSION_SECRET=your_random_secret_here
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
